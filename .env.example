APP_NAME=KAISAN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Production only: the hostname Caddy obtains a TLS certificate for.
APP_DOMAIN=

# One-time setup page for the first admin account.
# Set to false after the admin exists (see docs/05-DEPLOYMENT.md).
SETUP_ENABLED=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local dev defaults -- they match docker-compose.yml so `cp .env.example .env`
# followed by `docker compose up -d` just works. PRODUCTION MUST OVERRIDE
# DB_DATABASE and DB_PASSWORD (see docs/05-DEPLOYMENT.md).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kaisan_dev
DB_USERNAME=kaisan
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kaisanbimbel.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI router. Never commit real values: the key belongs in .env only.
AI_ROUTER_URL=
AI_ROUTER_KEY=
AI_ROUTER_MODEL=
AI_MONTHLY_BUDGET=
AI_ROUTER_TIMEOUT=120
AI_ROUTER_TRIES=3

# Cost guards. Raising these raises the client's bill.
AI_JOBS_PER_HOUR=20
AI_MAX_QUESTIONS_PER_JOB=20
AI_CACHE_TTL=86400

# Router price per one million tokens, for the admin cost recap.
AI_PRICE_PROMPT=0
AI_PRICE_COMPLETION=0
